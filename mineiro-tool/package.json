{
  "name": "mineiro-username-intelligence",
  "private": false,
  "version": "1.7.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "registry:stats": "tsx scripts/registry-stats.ts",
    "registry:validate": "tsx scripts/registry-validate.ts",
    "demo": "tsx scripts/demo-benchmark.ts",
    "manual:validate": "node scripts/validate-manual.mjs",
    "intelligence:test": "tsx scripts/intelligence-smoke.ts",
    "colab:validate": "node scripts/validate-colab.mjs",
    "docs:validate": "node scripts/validate-docs.mjs",
    "check": "npm run version:check && npm run brand:validate && npm run i18n:validate && npm run graph:test && npm run case:test && npm run registry:validate && npm run detectors:validate && npm run lint && npm run test && npm run demo && npm run intelligence:test && npm run manual:validate && npm run colab:validate && npm run docs:validate && npm run build",
    "brand:validate": "node scripts/validate-brand.mjs",
    "i18n:validate": "tsx scripts/i18n-smoke.ts",
    "graph:test": "tsx scripts/graph-hunting-smoke.ts",
    "case:test": "tsx scripts/case-diff-smoke.ts",
    "test": "vitest run",
    "detectors:validate": "tsx scripts/detectors-validate.ts",
    "detectors:health": "tsx scripts/detector-health.ts",
    "build:bundle": "esbuild server.ts --bundle --platform=node --format=cjs --external:vite --minify --legal-comments=none --outfile=dist/server.bundle.cjs",
    "build:python": "node scripts/build-python-package.mjs",
    "version:check": "node scripts/check-version.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^6.1.2",
    "d3": "^7.9.0",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "jpeg-js": "^0.4.4",
    "lucide-react": "^1.57.0",
    "motion": "^13.5.1",
    "pngjs": "^7.0.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "topojson-client": "^3.1.0",
    "undici": "^8.11.2",
    "vitest": "^5.0.3",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/express": "^5.0.0",
    "@types/node": "^22.14.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/topojson-client": "^3.1.5",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.4"
  },
  "description": "OSINT Investigation Workbench for public username presence, evidence review, cautious correlation and auditable local reporting."
}
